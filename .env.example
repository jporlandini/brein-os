# ── Auth ──────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Neon (PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/brein_os?sslmode=require

# ── Notion ────────────────────────────────────────
NOTION_TOKEN=secret_xxx
NOTION_DB_TASKS=your-tasks-database-id
NOTION_DB_CLIENTS=your-clients-database-id
NOTION_DB_OPERATORS=your-operators-database-id

# ── Vertex AI / Google Cloud ──────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# ── Email (Resend) ────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM=Brain OS <noreply@brein.cl>

# ── Telegram ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-xxx
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
